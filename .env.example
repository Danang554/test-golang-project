APP_NAME=test-golang-project
APP_HOST=127.0.0.1
APP_PORT=8080
APP_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=golang_db

# JWT Configuration
JWT_SECRET=super-secret-jwt-key-replace-this-in-production
JWT_EXPIRATION_HOURS=24

# Logging Configuration (Daily / Rotating Log)
LOG_DIR=storage/logs
LOG_LEVEL=info
LOG_MAX_SIZE=10
LOG_MAX_BACKUPS=14
LOG_MAX_AGE=14
LOG_COMPRESS=true
